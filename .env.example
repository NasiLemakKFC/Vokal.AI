# ==============================================================================
# InterViewAI — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# cp .env.example .env.local
# ==============================================================================

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/interviewai?retryWrites=true&w=majority
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
FASTAPI_BACKEND_URL=http://localhost:8000
