# ==============================================================================
# InterViewAI — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# cp .env.example .env.local
# ==============================================================================

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/interviewai?retryWrites=true&w=majority
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
FASTAPI_BACKEND_URL=http://localhost:8000

# ==============================================================================
# Module 1 AI Question & Resume Tailoring Provider
# AI_PROVIDER: auto | groq | gemini | ollama | offline
# In "auto" mode, tries Groq -> Gemini -> explicit Ollama -> Offline NLP fallback.
# ==============================================================================
AI_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional local Ollama (uncomment to prioritize or force AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
